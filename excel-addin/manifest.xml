<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Commodity Hub Excel add-in manifest.

  The Id must stay stable across releases — changing it makes Excel treat the
  add-in as a different one and users lose their sideload. Generate a fresh
  GUID only if you ever fork this into a genuinely separate product.

  Every URL below must be HTTPS and must be served with headers that allow
  framing (Office renders the task pane in an iframe in Excel on the web).
  See excel-addin/vercel.json — the app and landing hosts both send
  X-Frame-Options: DENY and cannot host this.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <Id>8f3c1d94-5b7a-4e21-9c68-2a1f0d7e4b53</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Commodity Hub</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Commodity Hub" />
  <Description DefaultValue="Live commodity prices, CFTC positioning, basis and hedge calculations as Excel formulas." />
  <IconUrl DefaultValue="https://excel.commodity-hub.eu/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://excel.commodity-hub.eu/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://commodity-hub.eu/api" />

  <AppDomains>
    <AppDomain>https://commodity-hub.eu</AppDomain>
    <AppDomain>https://app.commodity-hub.eu</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Workbook" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://excel.commodity-hub.eu/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">

        <!-- Custom functions: the =CH.PRICE(...) formulas. -->
        <AllFormFactors>
          <ExtensionPoint xsi:type="CustomFunctions">
            <Script>
              <SourceLocation resid="Functions.Script.Url" />
            </Script>
            <Page>
              <SourceLocation resid="Functions.Page.Url" />
            </Page>
            <Metadata>
              <SourceLocation resid="Functions.Metadata.Url" />
            </Metadata>
            <Namespace resid="Functions.Namespace" />
          </ExtensionPoint>
        </AllFormFactors>

        <!-- Ribbon button opening the task pane, where the API key is set. -->
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="CommodityHub.Group">
                <Label resid="Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="CommodityHub.TaskpaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>CommodityHub.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://excel.commodity-hub.eu/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://excel.commodity-hub.eu/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://excel.commodity-hub.eu/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Functions.Script.Url" DefaultValue="https://excel.commodity-hub.eu/functions.js" />
        <bt:Url id="Functions.Metadata.Url" DefaultValue="https://excel.commodity-hub.eu/functions.json" />
        <bt:Url id="Functions.Page.Url" DefaultValue="https://excel.commodity-hub.eu/functions.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://excel.commodity-hub.eu/taskpane.html" />
        <bt:Url id="Commands.Url" DefaultValue="https://excel.commodity-hub.eu/commands.html" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://commodity-hub.eu/api" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Functions.Namespace" DefaultValue="CH" />
        <bt:String id="Group.Label" DefaultValue="Commodity Hub" />
        <bt:String id="TaskpaneButton.Label" DefaultValue="Commodity Hub" />
        <bt:String id="GetStarted.Title" DefaultValue="Commodity Hub is ready" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Set your API key and see available formulas." />
        <bt:String id="GetStarted.Description" DefaultValue="Open the Commodity Hub pane to paste your API key, then use =CH.PRICE(&quot;Corn Futures&quot;) in any cell." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
