<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Disable Firebase auto-init at process start. @capacitor/push-notifications
             merges a FirebaseInitProvider into the manifest; if google-services.json
             is missing or malformed it crashes the app before any JS runs. We
             initialize FCM explicitly from JS via PushNotifications.register()
             after the user has signed in. -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth deep link callback (Supabase Google sign-in).
                 Catches every commodityhub:// URL so the system always reopens
                 the app, regardless of host/path used by the OAuth provider. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="commodityhub" android:host="auth-callback" />
            </intent-filter>

            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="commodityhub" />
            </intent-filter>

            <!-- Android App Links: verified https:// deep links into the web
                 app's domain, so a tapped link (Google Search results,
                 another app, etc.) opens straight into this app instead of a
                 browser when it's installed. autoVerify="true" makes Android
                 fetch https://app.commodity-hub.eu/.well-known/assetlinks.json
                 at install time and check it declares this app's package +
                 signing certificate — that file doesn't exist yet, see
                 public/.well-known/assetlinks.json for what's needed before
                 this actually verifies. No path restriction here (matches
                 every path under the host); useCapacitorAuthDeepLink.ts
                 handles routing the tapped path once the link opens the app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.commodity-hub.eu" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Facebook's SDK (bundled via @capgo/capacitor-social-login, even
         though Facebook login is never actually used anywhere in this app —
         see AuthContext.tsx, only Google is called) auto-declares this
         permission in its own library manifest. Disabling the Facebook
         provider via SocialLogin.providers instead (capacitor.config.ts)
         breaks R8 minification — the plugin's Java still references
         Facebook classes unconditionally, so excluding the dependency
         leaves unresolvable references. This is the plugin's own
         documented, R8-safe fix: keep the dependency, strip the resulting
         permission from the merged manifest directly. Required for the
         Play Console "does your app use advertising ID?" declaration to
         actually be true when answered "No". -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
</manifest>
