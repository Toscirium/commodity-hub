# Copy to `.env` and fill in. Values are baked into the client bundle at build
# time by Vite, so ONLY ever put publishable / client-safe values here.
#
# ----------------------------------------------------------------------------
# NEVER put a server-side credential in this file or in `.env`:
# a Supabase personal access token (sbp_...), a service-role key, a Stripe
# secret key, a RevenueCat secret (sk_...). Two separate reasons:
#
#   1. `.env` is currently TRACKED IN GIT (.gitignore lists `.env*`, but
#      gitignore does not untrack a file that is already tracked), so anything
#      added to it is pushed to GitHub.
#   2. Every VITE_-prefixed value is compiled into the JavaScript every visitor
#      downloads. There is no such thing as a secret VITE_ variable.
#
# Deploy-time credentials belong in GitHub Actions repository secrets
# (SUPABASE_ACCESS_TOKEN is read there by .github/workflows/deploy-functions.yml)
# or in `supabase login` for local CLI use. Never here.
# ----------------------------------------------------------------------------


# --- Required: absent values break a feature, silently and at build time -----

# Native Google Sign-In. AuthContext throws a build-time-empty error without it.
VITE_GOOGLE_WEB_CLIENT_ID=

# RevenueCat public SDK keys. VITE_REVENUECAT_API_KEY is the legacy Android key
# and is what src/services/revenueCat.ts falls back to when the dedicated
# Android key below is unset — so purchases break without one of the two.
VITE_REVENUECAT_API_KEY=
VITE_REVENUECAT_WEB_KEY=

# Affiliate destination for the broker CTA.
VITE_ETORO_AFFILIATE_URL=


# --- Optional: the app degrades cleanly when these are unset -----------------

# Product analytics + session replay. Everything no-ops without the key.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Read by src/services/revenueCat.ts but absent from the current .env.
# Android falls back to VITE_REVENUECAT_API_KEY above; iOS has no fallback.
VITE_REVENUECAT_ANDROID_KEY=
VITE_REVENUECAT_IOS_KEY=


# --- Has a hardcoded fallback: set only to override --------------------------

# Defaults to https://kcxhsmlqqyarhlmcapmj.supabase.co in
# src/integrations/supabase/client.ts. Set this to point at a custom auth
# domain — see docs/SUPABASE_CUSTOM_DOMAIN.md.
VITE_SUPABASE_URL=


# --- Deliberately omitted ----------------------------------------------------
#
# The tracked `.env` also carries SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY,
# VITE_SUPABASE_PROJECT_ID, VITE_SUPABASE_PUBLISHABLE_KEY, VITE_ADMOB_APP_ID,
# VITE_ADMOB_BANNER_ID, VITE_ADMOB_INTERSTITIAL_ID and
# VITE_ADSENSE_PUBLISHER_ID. None of them is referenced anywhere in src/,
# landing/, excel-addin/, index.html, vite.config.ts or android/ — the Supabase
# publishable key is hardcoded in client.ts, and no ad SDK is wired up. They
# are left out here rather than propagated; drop them from `.env` too when
# convenient.
